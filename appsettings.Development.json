{
  "Serilog": {
    "MinimumLevel": "Information",

    "WriteTo": [
      {
        "Name": "Console"
      }
   
    ],

    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],

    "Properties": {
      "ApplicationName": "SurveyBasket",
      "Environment": "Development"
    }
  },

  "AllowedOrigins": [
    "http://localhost:5173",
    "http://localhost:5172"
  ]
}